# ---------------------------------------------------------------------------
# Banco de dados da aplicacao (PostgreSQL) - dono do PONTO
# ---------------------------------------------------------------------------
# Com Docker local:
DATABASE_URL="postgresql://turin:turin_dev@localhost:5432/turin_ponto?schema=public"
# Sem Docker, usando Neon/Supabase, cole a connection string deles aqui.

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
PORT=3333
NODE_ENV=development
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ---------------------------------------------------------------------------
# Autenticacao
# ---------------------------------------------------------------------------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Cadastro de funcionarios: Alterdata Pack via proxy Analista-DP
# ---------------------------------------------------------------------------
# Somente leitura. E o mesmo proxy que o sistema de ferias (turin-ferias) usa:
# um unico ponto de integracao com o ERP, em vez de cada app abrir a sua
# conexao ao Postgres do Alterdata.
#
# Rota consumida: GET /empresas/{ALTERDATA_EMPRESA}/funcionarios
# Header de autenticacao: X-Proxy-Key
EMPLOYEE_SYNC_ENABLED=false
PROXY_API_URL=https://proxy-analista-dp.up.railway.app/api
PROXY_API_KEY=
# 00001 = a operacao com os departamentos Operacao / Manutencao / Adm.
ALTERDATA_EMPRESA=00001
PROXY_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Storage de selfies (S3 / MinIO)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=turin-ponto
S3_ACCESS_KEY=turin
S3_SECRET_KEY=turin_dev_storage
S3_REGION=us-east-1
