{
  "expo": {
    "name": "Meu Ponto Turin",
    "slug": "turin-ponto",
    "scheme": "turinponto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.turintransportes.ponto",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização apenas no momento do registro de ponto, para confirmar que você está na garagem.",
        "NSCameraUsageDescription": "A câmera tira uma foto de conferência no momento do registro. A foto fica no aparelho.",
        "NSFaceIDUsageDescription": "Use o Face ID para entrar no app sem digitar a senha."
      }
    },
    "android": {
      "package": "br.com.turintransportes.ponto",
      "adaptiveIcon": {
        "backgroundColor": "#0B711F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B711F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#062812"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização apenas no momento do registro de ponto, para confirmar que você está na garagem."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera tira uma foto de conferência no momento do registro. A foto fica no aparelho."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
