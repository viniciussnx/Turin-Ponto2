{
  "expo": {
    "name": "Meu Ponto Turin",
    "slug": "turin-ponto",
    "scheme": "turinponto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.turintransportes.ponto",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização apenas no momento do registro de ponto, para confirmar que você está na garagem.",
        "NSCameraUsageDescription": "A câmera é usada para a selfie que confirma quem está registrando o ponto.",
        "NSFaceIDUsageDescription": "Use o Face ID para entrar no app sem digitar a senha."
      }
    },
    "android": {
      "package": "br.com.turintransportes.ponto",
      "adaptiveIcon": {
        "backgroundColor": "#0BAF29",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07130D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": { "backgroundColor": "#050C08" }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização apenas no momento do registro de ponto, para confirmar que você está na garagem."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada para a selfie que confirma quem está registrando o ponto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
